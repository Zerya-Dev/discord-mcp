DISCORD_BOT_TOKEN=
ZDM_GUILD_ID=
ZDM_DB_PATH=data/zerya-discord-mcp.sqlite3
# Public origin of the HTTP app (OAuth issuer). Must be HTTPS on 443 for claude.ai.
ZDM_PUBLIC_URL=https://mcp.example.com
# Run as a pure indexer next to another bot that shares the token (no slash command sync).
ZDM_BOT_COMMANDS=false
HTTP_HOST=127.0.0.1
HTTP_PORT=8000
