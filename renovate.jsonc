{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "rangeStrategy": "bump",
  "extends": [
    "config:best-practices",
    ":semanticCommitTypeAll(chore)",
    "group:allNonMajor",
    ":preserveSemverRanges"
  ],
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions",
      "extends": ["schedule:weekly"]
    },
    {
      "matchManagers": ["pep621"],
      "groupName": "Python (uv)",
      "groupSlug": "python-uv",
      "extends": ["schedule:weekly"]
    },
    {
      // requires-python is ">=3.14, <3.15": move the interpreter (Docker base image, .python-version) to a new
      // minor version deliberately, together with requires-python, not as a "non-major" bump.
      "matchPackageNames": ["python"],
      "allowedVersions": "<3.15"
    }
  ],
  "dependencyDashboard": {
    "enabled": false
  }
}
